# =============================================================================
# .env.example — modelo de variáveis de ambiente da plataforma multi-cliente
# =============================================================================
#
# COMO USAR
#   - Local: copie este arquivo para `.env.local` e preencha com seus valores.
#     `.env.local` é ignorado pelo Git (nunca deve ser commitado).
#   - Vercel: as variáveis reais vivem no painel do projeto Vercel de cada
#     cliente, escopadas por ambiente (Production / Preview / Development).
#     Este arquivo é a FONTE DA VERDADE de QUAIS variáveis existem, não dos
#     valores. Um cliente novo sai deste arquivo -> painel Vercel dele.
#
# CONVENÇÕES DE SEGURANÇA (leia antes de adicionar variável nova)
#   🌍 NEXT_PUBLIC_*   → vai pro bundle do navegador. NUNCA colocar segredo aqui.
#   🔒 (as demais)     → só server-side. NUNCA acessar a partir de Client Component.
#   ⚙️ OPERAÇÃO        → tokens muito poderosos (Supabase Management, Vercel API).
#                       vivem SÓ na máquina de operação/CI (scripts/), NUNCA no
#                       app deployado, NUNCA em NEXT_PUBLIC_*.
#
# Se a variável cair no default definido em código, ela é OPCIONAL (comentada).
# Se ela precisa ser preenchida pro sistema funcionar, ela é OBRIGATÓRIA (sem #).
#
# Categorias:
#   1. App / URLs
#   2. Marca (white-label)
#   3. Supabase (banco do cliente)
#   4. Admin (PINs multi-usuário + cookie)
#   5. Cron / jobs internos
#   6. Pagar.me — pagamento dos PEDIDOS (split 3-way)
#   7. InfinitePay — cadastro / mensalidade das revendedoras
#   8. PagBank — fallback de pagamento (inativo por padrão)
#   9. Correios PPN — frete real
#  10. Resend — e-mails transacionais
#  11. Tray — catálogo (opcional por cliente)
#  12. SG / ERP externo (opcional)
#  13. Taxas / parâmetros de negócio
#  14. Feature flags (por cliente)
#  15. Testes (Playwright)
#  16. Operação / provisionamento (Supabase Management, Vercel API)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. App / URLs
# -----------------------------------------------------------------------------
# Base URL usada em redirect_url / webhook_url (Pagar.me, InfinitePay).
APP_URL=https://exemplo.com.br
# 🌍 Domínio canônico usado em e-mails e links compartilháveis. Igual a APP_URL.
NEXT_PUBLIC_APP_URL=https://exemplo.com.br


# -----------------------------------------------------------------------------
# 2. Marca (white-label) — sem estas, cai no default "Loja de Prata 925".
#    Detalhes: docs/WHITE_LABEL.md e src/lib/brand.ts
# -----------------------------------------------------------------------------
# 🌍 Nome comercial (títulos, e-mails, rodapés).
NEXT_PUBLIC_BRAND_NOME=
# 🌍 1ª parte do logo textual (ex: "Lunara").
NEXT_PUBLIC_BRAND_LOGO_PREFIXO=
# 🌍 2ª parte (colorida) do logo textual (ex: "Joias"). Vazio = sem split.
NEXT_PUBLIC_BRAND_LOGO_DESTAQUE=
# 🌍 Nome do supplier do catálogo (split + selo).
NEXT_PUBLIC_BRAND_FORNECEDOR=
# 🌍 Caminho do logo do fornecedor (asset local em public/branding/).
NEXT_PUBLIC_BRAND_FORNECEDOR_LOGO=
# 🌍 Operadora legal (rodapé / privacidade).
NEXT_PUBLIC_BRAND_OPERADORA=
# 🌍 Domínio da marca sem protocolo (ex: "lunarajoias.com.br").
NEXT_PUBLIC_BRAND_DOMINIO=
# 🌍 Cor de destaque (logo/acentos). Hex.
NEXT_PUBLIC_BRAND_COR=
# 🌍 Fonte do catálogo: "tray" (sync auto) ou "manual" (CRUD no admin).
NEXT_PUBLIC_BRAND_CATALOGO=manual


# -----------------------------------------------------------------------------
# 3. Supabase — banco DAQUELE cliente (silo).
#    Cada cliente aponta pro SEU projeto Supabase. NUNCA reaproveitar entre clientes.
# -----------------------------------------------------------------------------
# 🌍 URL do projeto Supabase deste cliente.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# 🌍 Anon key (auth client-side).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 🔒 Service role key — bypassa RLS. SÓ server-side. NUNCA em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 4. Admin — auth por PIN multi-usuário (NÃO usa auth.users).
#    O login /admin identifica QUEM é pelo PIN e grava cookie assinado (HttpOnly).
#    Detalhes: src/lib/adminAuth.ts
# -----------------------------------------------------------------------------
# 🔒 PIN "master" (Bearer/curl e fallback). Use PIN LONGO e aleatório (12+ chars).
ADMIN_PIN=
# 🔒 Segredo p/ assinar o cookie admin. Se ausente, derivado do ADMIN_PIN via HMAC.
#    Recomendo definir explicitamente em produção pra desacoplar do PIN.
# ADMIN_COOKIE_SECRET=
# 🔒 PINs por pessoa (audit log identifica quem fez o quê).
# ADMIN_PIN_GABBY=
# ADMIN_PIN_ANDERSON=
# ADMIN_PIN_ESCRITORIO=
# 🔒 PIN de somente-leitura (middleware bloqueia POST/PATCH/PUT/DELETE em /api/admin).
# ADMIN_PIN_VIEWER=
# E-mail(s) do admin (alertas de match faltando, etc.). Vírgula separa vários.
ADMIN_EMAIL=
# ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# 5. Cron / jobs internos
# -----------------------------------------------------------------------------
# 🔒 Bearer usado pelos crons (além do header `x-vercel-cron`).
CRON_SECRET=


# -----------------------------------------------------------------------------
# 6. Pagar.me — pagamento dos PEDIDOS (split 3-way)
#    Detalhes: docs/integrations/PAGARME.md
# -----------------------------------------------------------------------------
# 🔒 Secret key. Sem ela, o checkout cai pro PagBank (se configurado).
PAGARME_SECRET_KEY=
# Trocar p/ sandbox em dev se precisar. Default: https://api.pagar.me/core/v5
# PAGARME_BASE_URL=
# Máx. de parcelas sem juros exibido no checkout.
PAGARME_MAX_PARCELAS=3
# TTL do PIX em segundos (default: 3600).
# PAGARME_PIX_EXPIRA_S=3600
# Recipient "conta mãe" (0,5% + sobra do split).
PAGARME_MAIN_RECIPIENT_ID=
# Recipient do supplier (fornecedor central do catálogo).
PAGARME_PRATA15_RECIPIENT_ID=
# Percentuais (fração 0..1). Defaults: 0.30 / 0.695.
# PAGARME_REVENDEDORA_PERCENT=0.30
# PAGARME_PRATA15_PERCENT=0.695
# 🔒 Basic Auth pro webhook /api/webhook/pagarme (evita webhook forjado).
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASS=


# -----------------------------------------------------------------------------
# 7. InfinitePay — pagamento do CADASTRO / MENSALIDADE da revendedora
#    Detalhes: src/lib/infinitepayConfig.ts
# -----------------------------------------------------------------------------
# InfiniteTag (handle) da conta que recebe. Default: "oceanit".
# INFINITEPAY_HANDLE=oceanit
# 🔒 Token compartilhado no webhook /api/webhook/infinitepay.
INFINITEPAY_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# 8. PagBank — fallback de pagamento (no-op sem PAGBANK_TOKEN)
# -----------------------------------------------------------------------------
# 🔒 Sem esta, PagBank é no-op. Setar habilita o fallback.
# PAGBANK_TOKEN=
# PAGBANK_BASE_URL=
# 🔒 Token no webhook /api/webhook/pagbank.
# PAGBANK_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# 9. Correios PPN — frete real
#    Sem estas, cai pra tabela fixa por região (docs/integrations/CORREIOS.md).
# -----------------------------------------------------------------------------
# 🔒 Auth Basic da API PPN.
CORREIOS_USUARIO=
CORREIOS_SENHA=
# Nº do contrato (10 dígitos).
CORREIOS_CONTRATO=
# Cartão de postagem (10 dígitos, com zeros à esquerda).
CORREIOS_CARTAO_POSTAGEM=
# Código NUMÉRICO da DR (não é sigla). Ex: 72 = Sergipe.
CORREIOS_DR=
# CEP origem (8 dígitos, sem hífen).
CORREIOS_CEP_ORIGEM=
# Códigos PAC/SEDEX DO CONTRATO (não os de balcão 04510/04014).
CORREIOS_PAC_CODIGO=
CORREIOS_SEDEX_CODIGO=


# -----------------------------------------------------------------------------
# 10. Resend — e-mails transacionais
# -----------------------------------------------------------------------------
# 🔒 API key. Sem ela, e-mails são silenciosos (logam e seguem).
RESEND_API_KEY=
# Remetente. Endereço TEM que ser do domínio verificado no Resend.
# O nome de exibição é forçado a brand.nome no código.
EMAIL_FROM=Loja de Prata 925 <pedidos@exemplo.com.br>
# BCC de monitoramento em TODO e-mail. Vazio ("") desliga.
# MONITOR_EMAIL_BCC=


# -----------------------------------------------------------------------------
# 11. Tray — catálogo (opcional por cliente)
# -----------------------------------------------------------------------------
# Endpoint web_api público. Default: https://www.pratade15reais.com.br/web_api
# TRAY_BASE_URL=
# Kill-switch do sync diário. Setar "0" DESLIGA (best-sellers/destaques param).
# TRAY_SYNC_ENABLED=


# -----------------------------------------------------------------------------
# 12. SG / ERP externo (opcional)
# -----------------------------------------------------------------------------
# 🔒 SG_USUARIO=
# 🔒 SG_SENHA=


# -----------------------------------------------------------------------------
# 13. Taxas / parâmetros de negócio
# -----------------------------------------------------------------------------
# Percentual (fração 0..1) da taxa do gateway usada no cálculo do saldo.
# TAXA_GATEWAY_PCT=
# Percentual (fração 0..1) da taxa Ocean usada no cálculo do saldo.
# TAXA_OCEAN_PCT=
# 🌍 Valor da mensalidade exibido na UI. Default: 39.90
# NEXT_PUBLIC_MENSALIDADE=39.90


# -----------------------------------------------------------------------------
# 14. Feature flags — liga/desliga módulos por cliente (introduzidas na Fase 4)
#     Ler via src/lib/features.ts. Bloquear no route handler, não só na UI.
# -----------------------------------------------------------------------------
# CRUD manual de produtos no admin (para clientes que não usam Tray).
# FEATURE_ECOMMERCE=false
# Módulo de integração com WhatsApp (mensagens automáticas).
# FEATURE_WHATSAPP=false
# Módulo de relatório avançado (dashboards extras no admin).
# FEATURE_RELATORIO=false


# -----------------------------------------------------------------------------
# 15. Testes (Playwright)
# -----------------------------------------------------------------------------
# URL alvo dos testes E2E. Default: https://lojadeprata925.com.br
# BASE_URL=http://localhost:3000
# Libera testes que MUTAM o banco (default: bloqueado).
# ALLOW_MUTATING_TESTS=0
# Credenciais / slug pra testes autenticados.
# TEST_EMAIL=
# TEST_PASSWORD=
# TEST_STORE_SLUG=
# 🔒 Token admin usado por testes (opcional).
# ADMIN_TOKEN=


# -----------------------------------------------------------------------------
# 16. Operação / provisionamento — ⚙️ NUNCA usar em runtime do app
#     Ficam SÓ no ambiente de operação (máquina/CI), usadas por scripts/.
# -----------------------------------------------------------------------------
# 🔒⚙️ Supabase Management API (aplicar SQL, criar projeto).
#     Guardar com MUITO cuidado — dá acesso total à organização Supabase.
# SUPABASE_ACCESS_TOKEN=
# 🔒⚙️ Vercel API token (criar projeto, setar envs, apontar domínio).
# VERCEL_TOKEN=
# ID do time Vercel usado ao criar projetos (opcional).
# VERCEL_TEAM_ID=
