    "test:load:carga": "k6 run --env MODO=carga tests/load/stress-mix.js",
    "test:load:stress": "k6 run --env MODO=stress tests/load/stress-mix.js",
    "test:load:spike": "k6 run --env MODO=spike tests/load/stress-mix.js",
    "test:load:autenticado": "dotenv -e .env.test -- k6 run tests/load/autenticado.js"
